# Backend Environment Variables Template (Render Deployment)
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# CORS Configuration (Set to your future Vercel frontend URL in production)
CLIENT_ORIGIN=http://localhost:3000,https://skin-cancer-screening.vercel.app

# Machine Learning Model & Pipeline Settings
MODEL_NAME="CNN-EfficientNetB4 + ViT-Base"
MODEL_PATH="./models/cnn_vit_skin_cancer.onnx"
API_SECRET_KEY="your-production-secret-key"

# Google Gemini API Key for AI Chatbot Assistant
GEMINI_API_KEY=your_gemini_api_key_here
